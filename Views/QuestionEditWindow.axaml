<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MVC_C_sharp.Views.QuestionEditWindow"
        Title="Édition de la question"
        Width="600" Height="500"
        WindowStartupLocation="CenterOwner">
    
    <DockPanel Margin="20">
        
        
        <TextBlock Name="TxtTitreFenetre" 
                   DockPanel.Dock="Top"
                   Text="Nouvelle question" 
                   FontSize="20" 
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>
        
        
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
            <Button Name="BtnAnnuler" Content="Annuler" Padding="20,10" Click="BtnAnnuler_Click"/>
            <Button Name="BtnEnregistrer" Content="Enregistrer" Padding="20,10" Click="BtnEnregistrer_Click"/>
        </StackPanel>
        
        
        <TextBlock Name="TxtErreur" 
                   DockPanel.Dock="Bottom"
                   Foreground="Red" 
                   IsVisible="False"
                   Margin="0,10,0,0"/>
        
        
        <StackPanel Spacing="15">
            
            
            <StackPanel Spacing="5">
                <TextBlock Text="Libellé de la question :"/>
                <TextBox Name="TxtLibelle" 
                         Watermark="Ex: 192.1024.3.3 est-elle une adresse IP valide ?"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Height="80"/>
            </StackPanel>
            
            
            <StackPanel Spacing="5">
                <TextBlock Text="Type de réponse :"/>
                <ComboBox Name="CboTypeReponse" Width="200" SelectionChanged="CboTypeReponse_SelectionChanged">
                    <ComboBoxItem Content="Vrai/Faux" Tag="VraiFaux"/>
                    <ComboBoxItem Content="Liste de valeurs" Tag="ListeValeurs"/>
                </ComboBox>
            </StackPanel>
            
            
            <StackPanel Name="PanelVraiFaux" Spacing="5">
                <TextBlock Text="Réponse correcte :"/>
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <RadioButton Name="RbVrai" Content="Vrai" GroupName="VraiFaux"/>
                    <RadioButton Name="RbFaux" Content="Faux" GroupName="VraiFaux" IsChecked="True"/>
                </StackPanel>
            </StackPanel>
            
            
            <StackPanel Name="PanelListeValeurs" Spacing="10" IsVisible="False">
                <TextBlock Text="Valeurs possibles :"/>
                
                
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="20,0,0,0">
                    <TextBox Name="TxtNouvelleValeur" Width="280" Watermark="Nouvelle valeur"/>
                    <CheckBox Name="ChkEstCorrecte" Content="Correcte" VerticalAlignment="Center"/>
                    <Button Content="Ajouter" Click="BtnAjouterValeur_Click"/>
                </StackPanel>
                
                
                <DataGrid Name="GridReponses"
                          Height="150"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserReorderColumns="False"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Valeur" Binding="{Binding Valeur}" Width="*"/>
                        <DataGridCheckBoxColumn Header="Correcte" Binding="{Binding EstCorrecte}" Width="80"/>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Supprimer" Click="MenuSupprimerReponse_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </StackPanel>
            
        </StackPanel>
        
    </DockPanel>
</Window>
