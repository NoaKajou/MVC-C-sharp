<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MVC_C_sharp.Views.QuestionnairePlayWindow"
        Title="Répondre au questionnaire"
        Width="700" Height="500"
        WindowStartupLocation="CenterOwner">
    
    <DockPanel Margin="20">
        
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <TextBlock Name="TxtTitreQuestionnaire" 
                       Text="Questionnaire" 
                       FontSize="24" 
                       FontWeight="Bold"/>
            <TextBlock Name="TxtTheme" 
                       Text="Thème" 
                       FontSize="14"/>
            <TextBlock Name="TxtProgression" 
                       Text="Question 1/10" 
                       FontSize="12"
                       Margin="0,10,0,0"/>
        </StackPanel>
        
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
            <Button Name="BtnQuitter" Content="Quitter" Padding="20,10" Click="BtnQuitter_Click"/>
            <Button Name="BtnPrecedent" Content="Précédent" Padding="20,10" Click="BtnPrecedent_Click" IsEnabled="False"/>
            <Button Name="BtnSuivant" Content="Suivant" Padding="20,10" Click="BtnSuivant_Click"/>
        </StackPanel>
        
        <Border Padding="20">
            <StackPanel Spacing="20">
                
                <TextBlock Name="TxtQuestion" 
                           Text="Question ici..." 
                           FontSize="18"
                           TextWrapping="Wrap"/>
                
                <StackPanel Name="PanelVraiFaux" Spacing="10">
                    <RadioButton Name="RbVrai" Content="Vrai" GroupName="Reponse" FontSize="16"/>
                    <RadioButton Name="RbFaux" Content="Faux" GroupName="Reponse" FontSize="16"/>
                </StackPanel>
                
                <StackPanel Name="PanelListeValeurs" Spacing="10" IsVisible="False">
                    <ItemsControl Name="ListeReponses">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Content="{Binding Valeur}" 
                                             GroupName="ReponseValeur" 
                                             FontSize="16"
                                             Margin="0,5"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                
                <Border Name="PanelResultat" IsVisible="False" Padding="20" CornerRadius="5">
                    <StackPanel Spacing="10">
                        <TextBlock Name="TxtResultat" 
                                   FontSize="20" 
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Name="TxtScore" 
                                   FontSize="16"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
            </StackPanel>
        </Border>
        
    </DockPanel>
</Window>
