<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MVC_C_sharp.Views.QuestionnaireEditWindow"
        Title="Édition du questionnaire"
        Width="700" Height="500"
        WindowStartupLocation="CenterOwner">
    
    <DockPanel Margin="20">
        
        <TextBlock Name="TxtTitreFenetre" 
                   DockPanel.Dock="Top"
                   Text="Nouveau questionnaire" 
                   FontSize="20" 
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>
        
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Nom :" VerticalAlignment="Center" Width="80"/>
                <TextBox Name="TxtNom" Width="300" Watermark="Nom du questionnaire"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Thème :" VerticalAlignment="Center" Width="80"/>
                <ComboBox Name="CboTheme" Width="300">
                    <ComboBoxItem Content="Développement"/>
                    <ComboBoxItem Content="Réseau"/>
                    <ComboBoxItem Content="Culture générale"/>
                </ComboBox>
            </StackPanel>
        </StackPanel>
        
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
            <Button Name="BtnAnnuler" Content="Annuler" Padding="20,10" Click="BtnAnnuler_Click"/>
            <Button Name="BtnEnregistrer" Content="Enregistrer" Padding="20,10" Click="BtnEnregistrer_Click"/>
        </StackPanel>
        
        <TextBlock Name="TxtErreur" 
                   DockPanel.Dock="Bottom"
                   Foreground="Red" 
                   IsVisible="False"
                   Margin="0,10,0,0"/>
        
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Questions :" FontWeight="Bold" Margin="0,0,0,10"/>
            
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                <Button Content="Ajouter question" Click="MenuAjouterQuestion_Click"/>
                <Button Content="Editer" Click="MenuEditerQuestion_Click"/>
                <Button Content="Supprimer" Click="MenuSupprimerQuestion_Click"/>
            </StackPanel>
            
            <DataGrid Name="GridQuestions"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="True"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="N°" Binding="{Binding Numero}" Width="50"/>
                    <DataGridTextColumn Header="Question" Binding="{Binding Libelle}" Width="*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding TypeReponse}" Width="120"/>
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Ajouter" Click="MenuAjouterQuestion_Click"/>
                        <MenuItem Header="Editer" Click="MenuEditerQuestion_Click"/>
                        <MenuItem Header="Supprimer" Click="MenuSupprimerQuestion_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </DockPanel>
        
    </DockPanel>
</Window>
