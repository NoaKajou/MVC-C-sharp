<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MVC_C_sharp.Views.AccountInterface"
        Title="Mon Profil"
        Width="700" Height="820"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <StackPanel Grid.Row="0" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Spacing="10" 
                    Margin="15">
            <Button Name="BtnRetour"
                    Content="Retour à l'accueil"
                    Click="BtnRetour_Click"/>
            
            <Button Name="BtnDeconnexion"
                    Content="Se déconnecter"
                    Background="#E74C3C"
                    Foreground="White"
                    Click="BtnDeconnexion_Click"/>
        </StackPanel>

        <Border Grid.Row="1" Padding="30">
            <StackPanel Spacing="20">
            
                <StackPanel HorizontalAlignment="Center" Spacing="10">
                    <Border Width="80" Height="80" 
                            CornerRadius="40" 
                            Background="#5865F2"
                            HorizontalAlignment="Center">
                        <TextBlock Name="TxtInitiale"
                                   Text="U"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Name="TxtPseudo"
                               Text="Pseudo"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>

            <Separator Margin="0,10"/>

            
            <StackPanel Spacing="15">
                <TextBlock Text="Informations du compte"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                
                <Border Background="#534f4f" CornerRadius="8" Padding="15">
                    <DockPanel>
                        <TextBlock Text="ID"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Width="100"/>
                        <TextBlock Name="TxtId"
                                   Text="-"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                
                <Border Background="#534f4f" CornerRadius="8" Padding="15">
                    <DockPanel>
                        <TextBlock Text="Pseudo"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Width="100"/>
                        <TextBlock Name="TxtPseudoInfo"
                                   Text="-"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                
                <Border Background="#534f4f" CornerRadius="8" Padding="15">
                    <DockPanel>
                        <TextBlock Text="Email"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Width="100"/>
                        <TextBlock Name="TxtEmail"
                                   Text="-"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </StackPanel>

            <Separator Margin="0,10"/>

            <StackPanel Spacing="10">
                <TextBlock Text="Mes Questionnaires"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>
                
                <Border Background="#534f4f" CornerRadius="8" Padding="10" MaxHeight="200">
                    <ScrollViewer>
                        <ListBox Name="ListQuestionnaires"
                                 Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Nom}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Theme}" FontSize="12" Opacity="0.7"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding NombreQuestions, StringFormat='{}{0} questions'}" 
                                                   VerticalAlignment="Center"
                                                   Opacity="0.7"
                                                   Margin="10,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Border>
                
                <TextBlock Name="TxtAucunQuestionnaire"
                           Text="Aucun questionnaire créé"
                           IsVisible="False"
                           HorizontalAlignment="Center"
                           Opacity="0.7"/>
            </StackPanel>

            <Separator Margin="0,10"/>

            <StackPanel Spacing="10">
                <TextBlock Text="Historique des questionnaires joues"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <Border Background="#534f4f" CornerRadius="8" Padding="10" MaxHeight="220">
                    <ScrollViewer>
                        <ListBox Name="ListHistoriqueQuestionnaires"
                                 Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding QuestionnaireNom}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Resume}" FontSize="12" Opacity="0.7"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Border>

                <TextBlock Name="TxtAucunHistorique"
                           Text="Aucun historique pour le moment"
                           IsVisible="False"
                           HorizontalAlignment="Center"
                           Opacity="0.7"/>
            </StackPanel>

            </StackPanel>
        </Border>
    </Grid>

</Window>