<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MVC_C_sharp.Views.LoginWindow"
        Title="Connexion au super questionnaire ultra privé de noa"
        Width="400" Height="500"
        WindowStartupLocation="CenterScreen"
        CanResize="False">
    
    <Border Padding="30">
        <StackPanel VerticalAlignment="Center" Spacing="15">
            
            <TextBlock Text="QUESTIONNAIRE du ngoulougoulou du cante" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center"/>
            
            <TextBlock Text="Connecte toi sale chien" 
                       FontSize="14" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>
            
            <StackPanel Spacing="10">
                <TextBlock Text="Email ou Pseudo (fais vite pitié)"/>
                <TextBox Name="TxtIdentifiant" 
                         Watermark="Femboy@furry.com"/>
                
                <TextBlock Text="Word de passe"/>
                <TextBox Name="TxtMotDePasse" 
                         PasswordChar="●"
                         Watermark="try again"/>
            </StackPanel>
            
            <TextBlock Name="TxtErreur" 
                       Foreground="Red" 
                       HorizontalAlignment="Center"
                       IsVisible="False"/>
            
            <TextBlock Name="TxtSucces" 
                       Foreground="Green" 
                       HorizontalAlignment="Center"
                       IsVisible="False"/>
            
            <Button Name="BtnAction" 
                    Content="Connectouze" 
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="15,10"
                    Margin="0,10,0,0"
                    Click="BtnAction_Click"/>

            <Button Name="BtnInscription" 
                    Content="Toujours pas de comptes ? Inscrit toi sale femboy"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="15,10"
                    Margin="0,10,0,0"
                    Click="BtnInscription_Click"/>
        </StackPanel>
    </Border>
</Window>
